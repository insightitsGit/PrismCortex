# Copy to .env (which is gitignored) and fill in your real key.
# Used by deploy/azure_bench.sh and local runs. Never commit the filled-in .env.
GEMINI_API_KEY=your-gemini-api-key
# Optional: pin a dated model snapshot for true replay-determinism.
# PRISMCORTEX_MODEL=gemini-2.5-flash

# PyPI publish — scripts/publish_pypi.ps1 (never commit a real token)
# PYPI_API_TOKEN=pypi-...

# Competitive benchmarks (optional)
# ZEP_API_KEY=...                    # benchmarks/vs_zep.py live Zep comparison
# PRISM_BENCH_INGEST_LIMIT=40        # cap Gemini digests during LoCoMo smoke runs
